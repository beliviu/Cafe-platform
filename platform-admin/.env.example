# Project Supabase yang SAMA dengan web-dashboard.
# Pakai kunci publik (anon / publishable). JANGAN isi kunci service-role / secret di sini.
VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_publishable_key

# File SQL 18: alamat web owner (web-dashboard) untuk "Lihat sebagai owner" & tautan halaman status publik.
# Token admin hanya diserahkan ke alamat ini (postMessage), tidak lewat URL.
VITE_OWNER_APP_URL=https://dashboard.domainkamu.id
