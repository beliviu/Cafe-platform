EXPO_PUBLIC_SUPABASE_URL=your_project_url
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_key

# Kafe untuk build aplikasi ini (cafes.id). Satu build = satu kafe.
# Kosong = kafe pertama di database (hanya aman selama baru ada satu kafe).
EXPO_PUBLIC_CAFE_ID=
# Nama cadangan bila data kafe belum termuat.
EXPO_PUBLIC_PLATFORM_NAME=dailybrew

# KHUSUS DEV/QA: 1 = data tiruan di memori (tidak menyentuh database). Jangan diisi di build produksi.
# Jalankan: EXPO_PUBLIC_MOCK=1 npx expo start --web
EXPO_PUBLIC_MOCK=
