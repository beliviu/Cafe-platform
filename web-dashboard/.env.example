VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_publishable_key

# Opsional (white-label)
# Nama bawaan sebelum kafe dikenali, mis. di halaman login.
VITE_PLATFORM_NAME=dailybrew
# Kunci web ini ke satu kafe: halaman login langsung tampil dengan logo & nama kafe itu.
# Isi dengan cafes.id. Kosongkan untuk mode multi-kafe.
VITE_CAFE_ID=
# Alamat aplikasi customer versi web (Expo web), dipakai untuk isi QR meja:
# QR berisi <alamat>/meja/<token>. Contoh: https://pesan.kopisenja.id
VITE_CUSTOMER_APP_URL=

# File SQL 18
# Kunci situs Cloudflare Turnstile untuk halaman /daftar (Cloudflare → Turnstile → Add widget → Site key).
# Secret key-nya diisi di Edge Function self-signup (TURNSTILE_SECRET_KEY), BUKAN di sini.
VITE_TURNSTILE_SITE_KEY=
# Alamat dashboard admin platform — hanya jendela dari alamat ini yang boleh membuka mode "lihat sebagai".
VITE_ADMIN_APP_URL=https://admin.domainkamu.id
